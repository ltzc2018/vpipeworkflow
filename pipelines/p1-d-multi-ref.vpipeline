{
  "id": "p1-d-multi-ref",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-Ref2VA-8bit"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "References: @Image1 is the subject sheet, @Image2 and @Image3 are style references showing the same artwork, @Video1 is the motion reference. Make a new video of the subject from @Image1, rendered in the artistic style of @Image2 and @Image3, with the camera movement and motion timing of @Video1. The subject sits on a wooden windowsill in warm late-afternoon sunlight, looks directly at the camera, blinks slowly and gently licks its paw. Audio: soft rhythmic purring, a faint breeze through the open window, distant birdsong outside. Normal real-time speed, no slow motion. No text, no captions, no logos."
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12.0,
        "audio_shift": 3.0,
        "audio_seconds": 0.0,
        "lora": "Pika-Labs/Pika-H3-Flex-ref2va",
        "lora_scale": 1.0
      }
    },
    {
      "id": "load-subject",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": "refs/minimax-h3-reference-subject.jpg"
      }
    },
    {
      "id": "size-subject",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-subject",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "stretch",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "load-style",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": "refs/klein-multi-ref-panda.jpg"
      }
    },
    {
      "id": "size-style",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-style",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "stretch",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "load-style2",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": "refs/klein-multi-ref-panda-crop.jpg"
      }
    },
    {
      "id": "size-style2",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-style2",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "stretch",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "load-motion",
      "type": "load-video",
      "iports": [],
      "config": {
        "input_url": "refs/motion-pan-right-124f.mp4"
      }
    },
    {
      "id": "motion-frames",
      "type": "video-to-rgb",
      "iports": [
        {
          "src": "load-motion",
          "oport": 0
        }
      ],
      "config": {
        "output_dtype": "u8"
      }
    },
    {
      "id": "size-motion",
      "type": "image-resample",
      "iports": [
        {
          "src": "motion-frames",
          "oport": 0
        }
      ],
      "config": {
        "width": 832,
        "height": 480,
        "fit": "stretch",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "stack-motion",
      "type": "temporal-stack",
      "iports": [
        {
          "src": "size-motion",
          "oport": 0
        }
      ],
      "config": {
        "mode": "video",
        "group_size": 0,
        "max_mb": 384
      }
    },
    {
      "id": "motion-pcm",
      "type": "audio-to-pcm",
      "iports": [
        {
          "src": "load-motion",
          "oport": 1
        }
      ],
      "config": {
        "output_sample_rate": 32000,
        "channels": 2,
        "chunk_duration_s": 30.0,
        "max_chunk_duration_s": 60.0
      }
    },
    {
      "id": "stack-pcm",
      "type": "temporal-stack",
      "iports": [
        {
          "src": "motion-pcm",
          "oport": 0
        }
      ],
      "config": {
        "mode": "audio",
        "group_size": 0
      }
    },
    {
      "id": "video-ref-encoder",
      "type": "video-ref-encoder",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "size-subject",
          "oport": 0
        },
        {
          "src": "size-style",
          "oport": 0
        },
        {
          "src": "size-style2",
          "oport": 0
        },
        {
          "src": "stack-motion",
          "oport": 0
        },
        {
          "src": "stack-pcm",
          "oport": 0
        }
      ],
      "config": {
        "frames": 124,
        "reference_image_short_edge": 1024,
        "unload_when_idle": "auto",
        "attach_audio": [
          5
        ]
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "video-ref-encoder",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "video-ref-encoder",
          "oport": 1
        },
        {
          "src": "video-ref-encoder",
          "oport": 2
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "height": 480,
        "width": 832,
        "frames": 124,
        "fps": 24,
        "steps": 6,
        "seed": 42,
        "i8_gemm": true,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "out/p1-d-multi-ref.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}