{
  "id": "p3-ext-part1",
  "stages": [
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12.0,
        "audio_shift": 3.0,
        "condition_timestep": 1.0,
        "audio_seconds": 0.0,
        "lora": "Pika-Labs/Pika-H3-Flex-fl2va",
        "lora_scale": 1.0
      }
    },
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-FL2VA-8bit"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "A tabby cat in a light blue denim jacket sits on a worn wooden windowsill in warm late-afternoon sunlight, slowly licking its paw and blinking, individual fur strands and the denim weave clearly resolved, shallow depth of field, camera very slowly pushes in. Audio: soft rhythmic purring, a faint breeze through the open window, distant birdsong outside. Normal real-time speed, no slow motion. No text, no captions, no logos."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "destroy"
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "height": 480,
        "width": 832,
        "frames": 124,
        "fps": 24,
        "steps": 6,
        "seed": 42,
        "i8_gemm": true,
        "ane_ffn": false,
        "sol_attn": false,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24,
        "pix_fmt": "yuv444p",
        "color_range": "full",
        "colorspace": "bt709"
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "out/p3-ext-part1.mp4",
        "enable_video": true,
        "enable_audio": true,
        "video_codec": "ffv1",
        "video_bitrate": 10240000,
        "video_gop_size": 24,
        "audio_codec": "alac",
        "audio_bitrate": 192000,
        "muxer_options": {
          "movflags": "+faststart"
        }
      }
    }
  ],
  "subpipelines": []
}