{
  "id": "p9-ref2va-768p-a",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-Ref2VA-8bit"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "References: @Image1 is the subject sheet. Make a new video of the subject from @Image1. The subject sits on a wooden windowsill in warm late-afternoon sunlight, looks directly at the camera, blinks slowly and gently licks its paw; the camera pushes in very slowly. Audio: soft rhythmic purring, a faint breeze through the open window, distant birdsong outside. Normal real-time speed, no slow motion. No text, no captions, no logos."
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 6.0,
        "audio_shift": 3.0,
        "audio_seconds": 0.0,
        "lora": "lightx2v/Minimax-h3-Turbo-ref2va-8step-768p",
        "lora_scale": 1.0
      }
    },
    {
      "id": "load-subject",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": "refs/minimax-h3-reference-subject.jpg"
      }
    },
    {
      "id": "size-subject",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-subject",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "stretch",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "video-ref-encoder",
      "type": "video-ref-encoder",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "size-subject",
          "oport": 0
        }
      ],
      "config": {
        "frames": 124,
        "reference_image_short_edge": 1024,
        "unload_when_idle": "auto"
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "video-ref-encoder",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "video-ref-encoder",
          "oport": 1
        },
        {
          "src": "video-ref-encoder",
          "oport": 2
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "height": 768,
        "width": 1344,
        "frames": 124,
        "fps": 24,
        "steps": 8,
        "seed": 42,
        "i8_gemm": true,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "out/p9-ref2va-768p-a.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}