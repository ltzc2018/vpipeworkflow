{
 "id": "pika-ref2va-ablation",
 "stages": [
  {
   "id": "model-select",
   "type": "model-select",
   "iports": [],
   "config": {
    "hf_dir": "local/MiniMax-H3-Ref2VA-8bit"
   }
  },
  {
   "id": "text-prompt",
   "type": "text-prompt",
   "iports": [],
   "config": {
    "text": "References: @Image1 is the subject sheet. The woman in @Image1 is dancing happily in a bright, modern living room, full body shot, fluid movements, laughing; the camera tracks her movement smoothly. Audio: upbeat pop music, rhythmic steps, faint laughter. Normal real-time speed, no slow motion. No text, no captions, no logos."
   }
  },
  {
   "id": "minimax-h3-model-config",
   "type": "minimax-h3-model-config",
   "iports": [],
   "config": {
    "video_shift": 12.0,
    "audio_shift": 3.0,
    "audio_seconds": 0.0,
    "lora": "Pika-Labs/Pika-H3-Flex-ref2va",
    "lora_scale": 1.0
   }
  },
  {
   "id": "video-ref-encoder",
   "type": "video-ref-encoder",
   "iports": [
    {
     "src": "text-prompt",
     "oport": 0
    },
    {
     "src": "model-select",
     "oport": 0
    }
   ],
   "config": {
    "references": [
     "/Users/minichen/AI-Models/vpipe-workspace/refs/real-woman-glasses.jpg"
    ],
    "frames": 124,
    "reference_image_short_edge": 1024,
    "reference_video_short_edge": 480,
    "reference_video_max_pixels": 399360,
    "unload_when_idle": "auto"
   }
  },
  {
   "id": "generate-video",
   "type": "generate-video",
   "iports": [
    {
     "src": "video-ref-encoder",
     "oport": 0
    },
    {
     "src": "",
     "oport": 0
    },
    {
     "src": "model-select",
     "oport": 0
    },
    {
     "src": "",
     "oport": 0
    },
    {
     "src": "",
     "oport": 0
    },
    {
     "src": "",
     "oport": 0
    },
    {
     "src": "",
     "oport": 0
    },
    {
     "src": "video-ref-encoder",
     "oport": 1
    },
    {
     "src": "video-ref-encoder",
     "oport": 2
    },
    {
     "src": "minimax-h3-model-config",
     "oport": 0
    }
   ],
   "config": {
    "height": 480,
    "width": 832,
    "frames": 124,
    "fps": 24,
    "steps": 6,
    "seed": 42,
    "i8_gemm": true,
    "unload_when_idle": "always"
   }
  },
  {
   "id": "vae-decode",
   "type": "vae-decode",
   "iports": [
    {
     "src": "generate-video",
     "oport": 0
    },
    {
     "src": "model-select",
     "oport": 0
    }
   ],
   "config": {}
  },
  {
   "id": "audio-vae-decode",
   "type": "audio-vae-decode",
   "iports": [
    {
     "src": "generate-video",
     "oport": 1
    },
    {
     "src": "model-select",
     "oport": 0
    }
   ],
   "config": {}
  },
  {
   "id": "rgb-to-video",
   "type": "rgb-to-video",
   "iports": [
    {
     "src": "vae-decode",
     "oport": 0
    }
   ],
   "config": {
    "fps": 24
   }
  },
  {
   "id": "save-video",
   "type": "save-video",
