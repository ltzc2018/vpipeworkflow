{
  "id": "boogu-image-edit",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "Boogu/Boogu-Image-0.1-Edit-Turbo"
      }
    },
    {
      "id": "load-ref",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": [
          "/Users/minichen/WorkBuddy/2026-11-12-21-10-11/vpipe-lab/frames-fid/ref-cat.png"
        ]
      }
    },
    {
      "id": "ref-resample",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-ref",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "crop",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "Replace the background with a neon-lit rainy cyberpunk alley at night, keep the same cat, same fur pattern, same pose and framing. Photorealistic, sharp focus, moody teal and magenta rim light."
      }
    },
    {
      "id": "boogu-model-config",
      "type": "boogu-image-model-config",
      "iports": [],
      "config": {}
    },
    {
      "id": "scheduler-select",
      "type": "scheduler-select",
      "iports": [],
      "config": {
        "type": "boogu_v1",
        "steps": 4,
        "seq_len": 4096
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "ref-resample",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "boogu-model-config",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "generate-image",
      "type": "generate-image",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "scheduler-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "boogu-model-config",
          "oport": 0
        }
      ],
      "config": {
        "height": 1024,
        "width": 1024,
        "steps": 4,
        "seed": 42
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-image",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "path": "out/boogu-edit-cat.jpeg",
        "quality": 95
      }
    }
  ],
  "subpipelines": []
}
