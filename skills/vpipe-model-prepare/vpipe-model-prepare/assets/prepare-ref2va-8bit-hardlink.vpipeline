{
  "id": "prepare-ref2va-8bit-hardlink",
  "_comment": "省空间版 Ref2VA 8-bit 准备：只量化 DiT，编码器 / 双 VAE / tokenizer 从 local/MiniMax-H3-FL2VA-8bit 硬链接复用。净增约 33 GB（官方全量流程约 60 GB）。前提：已备好 local/MiniMax-H3-FL2VA-8bit。本机实测：Ref2VA-8bit 目录 33 GB，text_encoders 与 vae 的 inode 与 FL2VA-8bit 相同（links=2/5）。",
  "stages": [
    {
      "id": "fetch",
      "type": "model-fetch",
      "iports": [],
      "config": {
        "model_path": "Comfy-Org/MiniMax-H3",
        "model_variant": "ref2va",
        "model_key": "Comfy-Org/MiniMax-H3-Ref2VA",
        "hf_token": "",
        "base_path": "./models",
        "skip_existing_files": true,
        "overwrite_existing": false
      }
    },
    {
      "id": "quant-dit",
      "type": "model-quantize",
      "iports": [
        {
          "src": "fetch",
          "oport": 0
        }
      ],
      "config": {
        "src_model": "Comfy-Org/MiniMax-H3-Ref2VA",
        "output_name": "local/MiniMax-H3-Ref2VA-8bit-dit",
        "target": "dit",
        "bits": 8,
        "group_size": 64,
        "quant_modulation": true,
        "skip_existing": false
      }
    },
    {
      "id": "hardlink-encoder-and-vae",
      "type": "shell",
      "iports": [
        {
          "src": "quant-dit",
          "oport": 0
        }
      ],
      "config": {
        "command": "set -e; SRC=models/local/MiniMax-H3-FL2VA-8bit; DST=models/local/MiniMax-H3-Ref2VA-8bit; mkdir -p \"$DST/text_encoders\" \"$DST/vae\" \"$DST/tokenizer\"; for f in \"$SRC\"/text_encoders/*; do ln -f \"$f\" \"$DST/text_encoders/$(basename \"$f\")\"; done; for f in \"$SRC\"/vae/*; do ln -f \"$f\" \"$DST/vae/$(basename \"$f\")\"; done; for f in \"$SRC\"/tokenizer/*; do ln -f \"$f\" \"$DST/tokenizer/$(basename \"$f\")\"; done; ls -li \"$DST/text_encoders\" | head",
        "allow": [
          "ls",
          "ln",
          "mkdir",
          "basename"
        ],
        "allow_network": false,
        "timeout_ms": 600000
      }
    },
    {
      "id": "remove-dit-intermediate",
      "type": "model-remove",
      "iports": [
        {
          "src": "hardlink-encoder-and-vae",
          "oport": 0
        }
      ],
      "config": {
        "model": "local/MiniMax-H3-Ref2VA-8bit-dit",
        "delete_files": true,
        "missing_ok": true
      }
    }
  ]
}
